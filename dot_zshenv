# ~/.zshenv — sourced by EVERY zsh: login, interactive, and scripts.
# Keep it cheap and side-effect free: no compinit, no plugins, no prompt.
# chezmoi source: dot_zshenv
#
# zsh startup order:
#   /etc/zshenv -> ~/.zshenv -> /etc/zprofile -> ~/.zprofile -> /etc/zshrc -> ~/.zshrc
#
# /etc/zshenv and /etc/zprofile are generated by nix-darwin (see
# ~/.config/nix-darwin/modules/common.nix) and already export the nix
# environment. The hand-rolled `brew shellenv` block that used to live here is
# gone: the generated /etc/zshrc runs `brew shellenv` itself.
#
# DO NOT set NOSYSZSHRC here. The old version of this file did, which made
# /etc/zshrc return immediately and silently disabled direnv, brew, the nix
# completions and every zsh plugin.

# ─── PATH ─────────────────────────────────────────────────────────────────────
# Single source of truth for the extra bin directories. `typeset -U path` keeps
# it de-duplicated, so anything also added by ~/.zprofile, by mise, or by
# /etc/zshrc collapses instead of stacking.
typeset -U path PATH
path=(
  "$HOME/fvm/default/bin"
  "$HOME/.mix/escripts"
  "$HOME/.pub-cache/bin"
  "$HOME/.bun/bin"
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"
  "$HOME/.antigravity/antigravity/bin"
  "$HOME/Library/pnpm"
  "/Applications/Nix Apps/WhatsApp.app/Contents/MacOS"
  $path
)

# ─── Android / Java ───────────────────────────────────────────────────────────
export ANDROID_HOME="$HOME/Library/Android/sdk"
export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
path=(
  "$ANDROID_HOME/tools"
  "$ANDROID_HOME/tools/bin"
  "$ANDROID_HOME/platform-tools"
  "$ANDROID_HOME/emulator"
  "$JAVA_HOME/bin"
  $path
)

# ─── toolchain homes ──────────────────────────────────────────────────────────
export GEM_HOME="$HOME/.gem"
export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/Library/pnpm"
export ERL_AFLAGS="-kernel shell_history enabled -kernel shell_history_file_bytes 1024000"
export CLICOLOR=1
